/* ============================================================
 * 02 计算 GTJA191 因子并写入分布式表 dfs://gtja/factor
 *
 *   依赖：本脚本不再 `use` 服务端模块（服务端已无因子模块）。
 *         因子公式由客户端 loader.py 注入到当前会话，函数名不带命名空间，
 *         例如 gtjaCalAlpha1 / gtjaAlpha1。
 *         请通过 run.py 运行：python run.py 2  （会自动先注入本地模块）
 *
 *   列名：market 表用 lab 自定义列名（Timestamp/Symbol/MidOpen/...），
 *         本脚本用官方 prepareData 适配成 GTJA191 标准字段后再计算，模块本身不改动。
 *
 *   输出长表：tradetime, securityid, alphaId, alphaValue
 *   因子矩阵行序 = 交易日升序，列序 = 证券代码升序（panel 会排序）
 *
 *   幂等：重复运行不会因为库/表已存在而失败。
 *         REBUILD_FACTOR = true（默认）-> 先删因子表再重建，结果必定干净
 *         REBUILD_FACTOR = false       -> 复用已有表，只补算还没算过的因子
 * ============================================================ */

login("admin", "123456")

// ---------------- 配置 ----------------
DB_URI = "dfs://gtja"
TB_MKT = "market"
TB_FAC = "factor"
if (!defined("REBUILD_FACTOR")) REBUILD_FACTOR = true

// 需要计算的因子编号（可改成 1..191 计算全部；21/30/116/147 官方未实现或需额外数据）
factorList = 1..32
skipList   = [21, 30, 116, 147]

// ---------------- 0. 前置检查 ----------------
if (size(exec name from defs() where name = "gtjaCalAlpha1") == 0) {
    throw "未找到 gtjaCalAlpha1：请用 `python run.py 2` 运行（run.py 会先注入 modules-local 里的公式）"
}
if (!existsDatabase(DB_URI)) {
    throw "数据库 " + DB_URI + " 不存在，请先运行: python run.py 1"
}
if (!existsTable(DB_URI, TB_MKT)) {
    throw "表 " + DB_URI + "/" + TB_MKT + " 不存在，请先运行: python run.py 1"
}

// ---------------- 1. 准备数据与面板 ----------------
// market 表用的是 lab 自定义列名；这里用官方 prepareData 适配回 GTJA191 标准字段，
// 之后 data 就是标准字段名（securityid/tradetime/open/close/high/low/vol/vwap/index_*）
market    = loadTable(DB_URI, TB_MKT)
startTime = exec min(Timestamp) from market
endTime   = exec max(Timestamp) from market

rawData = select * from market
data = prepareData(rawData = rawData, startTime = startTime, endTime = endTime,
                   securityidName = "Symbol",     tradetimeName  = "Timestamp",
                   openName       = "MidOpen",    closeName      = "MidClose",
                   highName       = "MidHigh",    lowName        = "MidLow",
                   volumeName     = "BarVolume",  vwapName       = "BarVwap",
                   indexCloseName = "IndexClose", indexOpenName  = "IndexOpen")

days = sort(exec distinct tradetime from data)    // 矩阵行标签（data 已是标准字段名）
sids = sort(exec distinct securityid from data)   // 矩阵列标签
nDay = size(days)
nSec = size(sids)
nRow = nDay * nSec

print("data: " + string(nDay) + " days x " + string(nSec) + " securities")

// ---------------- 2. 确保因子表就绪（幂等） ----------------
db = database(DB_URI)
if (existsTable(DB_URI, TB_FAC) and REBUILD_FACTOR) {
    dropTable(db, TB_FAC)
    print("已删除旧因子表 " + TB_FAC + "，将重建")
}

facSchema = table(1:0, `tradetime`securityid`alphaId`alphaValue,
                  [TIMESTAMP, SYMBOL, SYMBOL, DOUBLE])
if (existsTable(DB_URI, TB_FAC)) {
    facPt = loadTable(DB_URI, TB_FAC)
} else {
    facPt = db.createPartitionedTable(facSchema, TB_FAC, `tradetime`securityid)
}

// 非重建模式下，记录已经算过的因子，避免重复追加
existingIds = array(STRING)
if (!REBUILD_FACTOR) {
    existingIds = string(exec distinct alphaId from facPt)
}

// 矩阵（列优先 flatten）-> 长表
def repN(x, n) { return take(x, n) }
def matToLong(m, days, sids, nDay, nRow, alphaId) {
    return table(
        take(days, nRow)                     as tradetime,
        flatten(each(repN, sids, nDay))      as securityid,
        take(alphaId, nRow)                  as alphaId,
        m.flatten()                          as alphaValue
    )
}

// ---------------- 3. 逐个计算 ----------------
okList = array(INT)
failList = array(INT)
skipCnt = 0
t0 = now()

for (fid in factorList) {
    if (fid in skipList) { continue }
    alphaId = "ja" + string(fid)

    if (!REBUILD_FACTOR and alphaId in existingIds) {
        skipCnt = skipCnt + 1
        continue
    }

    try {
        callExpr = "gtjaCalAlpha" + string(fid) + "(data, startTime, endTime)"
        m = parseExpr(callExpr).eval()
        facPt.append!(matToLong(m, days, sids, nDay, nRow, alphaId))
        okList.append!(fid)
    } catch (ex) {
        failList.append!(fid)
        print("FAILED " + alphaId + " : " + ex)
    }
}

// ---------------- 4. 校验 ----------------
print("---- factor 表统计 ----")
print("computed = " + string(size(okList)) + " factors")
if (skipCnt > 0) {
    print("skipped  = " + string(skipCnt) + " factors (已存在)")
}
if (size(failList) == 0) {
    print("failed   = none")
} else {
    print("failed   = " + concat(string(failList), ", "))
}
print("elapsed  = " + string(now() - t0))

select count(*) as rows from loadTable(DB_URI, TB_FAC)
print("factorIds = " + concat(exec distinct alphaId from loadTable(DB_URI, TB_FAC), ", "))
print("02_calc_factors.dos done.")
