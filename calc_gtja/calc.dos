/* ============================================================
 * Family gtja: compute GTJA191 alpha and write into distributed table dfs://gtja/alpha
 *
 *   Family: gtja (see modules.json in the same directory for the module list to inject), alphaId prefix = "ja"
 *   Dependencies: the formula modules in this family folder calc_gtja/ (gtja191Alpha / gtja191Prepare),
 *         injected by ddb.py into the "family-exclusive session", function names carry no namespace (gtjaCalAlpha1 / gtjaAlpha1).
 *
 *   Column names: the market table uses lab custom column names (Timestamp/Symbol/MidOpen/...),
 *         this script uses the official prepareData to adapt them into GTJA191 standard fields before computing; the modules themselves are unchanged.
 *
 *   Output long table: tradetime, securityid, alphaId, alphaValue (alphaId = "ja"+number)
 *   alpha matrix row order = trading day ascending, column order = security code ascending (panel will sort)
 *
 *   Idempotent: the alpha table is shared by all families, so on rebuild it only deletes rows with this family's prefix, leaving other families untouched.
 *         REBUILD_ALPHA = true (default) -> first delete alphaId like "ja%" then recompute
 *         REBUILD_ALPHA = false       -> reuse the existing table, only compute the alphas not yet computed
 * ============================================================ */

// ---------------- Login (use the defaults below when not injected; the Python side injects DB_USER/DB_PASSWORD from config) ----------------
if (!defined("DB_USER"))     DB_USER     = "admin"
if (!defined("DB_PASSWORD")) DB_PASSWORD = "123456"
login(DB_USER, DB_PASSWORD)

// ---------------- Configuration (use the defaults below when not injected; when injected, the preamble takes precedence) ----------------
// run.py maps params to DolphinDB variables of the same name, assembles a preamble and puts it at the very front of this script;
// when running directly via the VS Code plugin etc. nothing is injected, so the defaults here are used -- both ways work.
if (!defined("DB_URI"))         DB_URI         = "dfs://gtja"
if (!defined("TB_MKT"))         TB_MKT         = "market"
if (!defined("TB_ALPHA"))       TB_ALPHA       = "alpha"
if (!defined("ALPHA_PREFIX"))   ALPHA_PREFIX   = "ja"    // this family's alphaId prefix
if (!defined("REBUILD_ALPHA")) REBUILD_ALPHA = true
// Optional: only compute the given security subset, comma-separated security codes (e.g. "sz000001,sz000002"); empty = all
// Note: cross-sectional alphas rank only within the subset, so values will differ from the full set.
if (!defined("SECURITY_IDS"))   SECURITY_IDS   = ""

// alpha IDs to compute (can be changed to 1..191 to compute all; 21/30/116/147 are not officially implemented or need extra data)
if (!defined("alphaList")) alphaList = 1..32
if (!defined("skipList"))  skipList  = [21, 30, 116, 147]
// Optional: only compute the specified IDs (injected by the preamble, e.g. [1,3,5]); if empty, use alphaList above
if (!defined("ALPHA_IDS")) ALPHA_IDS = []
if (size(ALPHA_IDS) > 0) alphaList = ALPHA_IDS

// ---------------- 0. Pre-check ----------------
if (size(exec name from defs() where name = "gtjaCalAlpha1") == 0) {
    throw "gtjaCalAlpha1 not found: please run via run.py's calc_gtja action (run.py injects the formulas in calc_gtja first)"
}
if (!existsDatabase(DB_URI)) {
    throw "Database " + DB_URI + " does not exist, please run the upload_csv_data action first"
}
if (!existsTable(DB_URI, TB_MKT)) {
    throw "Table " + DB_URI + "/" + TB_MKT + " does not exist, please run the upload_csv_data action first"
}

// ---------------- 1. Prepare data and panel ----------------
// the market table uses lab custom column names; here the official prepareData is used to adapt them back to GTJA191 standard fields,
// afterwards data uses the standard field names (securityid/tradetime/open/close/high/low/vol/vwap/index_*)
market    = loadTable(DB_URI, TB_MKT)
startTime = exec min(Timestamp) from market
endTime   = exec max(Timestamp) from market

rawData = select * from market
data = prepareData(rawData = rawData, startTime = startTime, endTime = endTime,
                   securityidName = "Symbol",     tradetimeName  = "Timestamp",
                   openName       = "MidOpen",    closeName      = "MidClose",
                   highName       = "MidHigh",    lowName        = "MidLow",
                   volumeName     = "BarVolume",  vwapName       = "BarVwap",
                   indexCloseName = "IndexClose", indexOpenName  = "IndexOpen")

// Optional: only keep the securities specified by SECURITY_IDS (if empty, no filtering, use all)
// Filter at the input side: subset computes cross-sectionally only on that subset, and sids / matrix columns / long table all follow the subsetting.
if (strlen(SECURITY_IDS) > 0) {
    subsetIds = each(trim, split(SECURITY_IDS, ","))
    data = select * from data where string(securityid) in subsetIds
    print("subset: " + string(size(exec distinct securityid from data)) + " securities")
}

days = sort(exec distinct tradetime from data)    // matrix row labels (data already uses standard field names)
sids = sort(exec distinct securityid from data)   // matrix column labels
nDay = size(days)
nSec = size(sids)
nRow = nDay * nSec

print("data: " + string(nDay) + " days x " + string(nSec) + " securities")

// ---------------- 2. Ensure the alpha table is ready (idempotent) ----------------
// the alpha table is shared by all families: create it if it does not exist; on rebuild only delete rows with this family's prefix (no dropTable).
db = database(DB_URI)
alphaSchema = table(1:0, `tradetime`securityid`alphaId`alphaValue,
                    [TIMESTAMP, SYMBOL, SYMBOL, DOUBLE])
if (existsTable(DB_URI, TB_ALPHA)) {
    alphaPt = loadTable(DB_URI, TB_ALPHA)
} else {
    alphaPt = db.createPartitionedTable(alphaSchema, TB_ALPHA, `tradetime`securityid)
}
if (REBUILD_ALPHA) {
    delete from alphaPt where alphaId like (ALPHA_PREFIX + "%")
    print("Deleted old alpha of this family (" + ALPHA_PREFIX + "), will recompute")
}

// In non-rebuild mode, record the alphas already computed to avoid duplicate appends
existingIds = array(STRING)
if (!REBUILD_ALPHA) {
    existingIds = string(exec distinct alphaId from alphaPt)
}

// matrix (column-major flatten) -> long table
def repN(x, n) { return take(x, n) }
def matToLong(m, days, sids, nDay, nRow, alphaId) {
    return table(
        take(days, nRow)                     as tradetime,
        flatten(each(repN, sids, nDay))      as securityid,
        take(alphaId, nRow)                  as alphaId,
        m.flatten()                          as alphaValue
    )
}

// ---------------- 3. Compute one by one ----------------
okList = array(INT)
failList = array(INT)
skipCnt = 0
t0 = now()

for (aid in alphaList) {
    if (aid in skipList) { continue }
    alphaId = ALPHA_PREFIX + string(aid)

    if (!REBUILD_ALPHA and alphaId in existingIds) {
        skipCnt = skipCnt + 1
        continue
    }

    try {
        callExpr = "gtjaCalAlpha" + string(aid) + "(data, startTime, endTime)"
        m = parseExpr(callExpr).eval()
        alphaPt.append!(matToLong(m, days, sids, nDay, nRow, alphaId))
        okList.append!(aid)
    } catch (ex) {
        failList.append!(aid)
        print("FAILED " + alphaId + " : " + ex)
    }
}

// ---------------- 4. Validation ----------------
print("---- alpha table statistics ----")
print("computed = " + string(size(okList)) + " alphas")
if (skipCnt > 0) {
    print("skipped  = " + string(skipCnt) + " alphas (already exist)")
}
if (size(failList) == 0) {
    print("failed   = none")
} else {
    print("failed   = " + concat(string(failList), ", "))
}
print("elapsed  = " + string(now() - t0))

select count(*) as rows from loadTable(DB_URI, TB_ALPHA)
print("alphaIds = " + concat(exec distinct alphaId from loadTable(DB_URI, TB_ALPHA), ", "))
print("calc.dos done.")
